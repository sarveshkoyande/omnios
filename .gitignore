# --- secrets / local env ---
.env
.env.*

# --- runtime data store (SQLite + blobs, reseeded from assets/seed + config) ---
/data/

# --- knowledge base: the committed seed (assets/seed/omni_kb.db) is a ~90MB dependency-slim
#     of the full KB (drops the large raw tables no app query/view uses); it seeds to the
#     persistent disk on boot. The full ~170MB master is kept local-only as the rebuild
#     source (scratch/slim_closure.py rebuilds the slim from it) and never committed. ---
/assets/seed/omni_kb_full.db

