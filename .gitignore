*.pyc
.venv/
venv/

# Local caches -- regenerated automatically (SQLite created on first run,
# raw/ repopulated by scrapers or by live on-demand API calls). Never commit
# project data either -- it may contain real brand/therapy-area chat history.
data/raw/
data/*.db
data/*.db-journal

.env

# Frontend (frontend/) -- reinstallable/regenerable; app/static/v2/ (the built output Render
# actually serves, since render.yaml has no Node build step) is committed, this isn't.
frontend/node_modules/
frontend/tsconfig.tsbuildinfo
